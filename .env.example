# 复制为 .env 后填写；.env 不入库（见 .gitignore）
# 未配置 RF_LLM_API_KEY 时，程序自动降级为 Fake 适配器，CI/e2e 永远使用 Fake。

# 是否读取本文件（.env）。1（默认）：读取；0/false/no：跳过。
# 测试进程会强制设为 0，避免开发者 shell 或仓库根目录的 .env 影响测试结果。
RF_LOAD_DOTENV=1

# auto（默认）：有 Key 走真实，无 Key 走 Fake；fake：强制 Fake；real：强制真实（缺少 Key 时报错）
RF_LLM_MODE=auto
RF_LLM_BASE_URL=https://api.openai.com/v1
RF_LLM_API_KEY=
RF_LLM_MODEL=gpt-4o-mini
RF_LLM_TIMEOUT_SECONDS=60

# checkpoint 后端。sqlite（默认）：落在 runs/<run_id>/checkpoint.sqlite，
# 支持"关掉进程、换个进程 resume"；memory：只在进程内有效，测试与调试用。
RF_CHECKPOINT_BACKEND=sqlite

# 模型能力配置。选型要求：同时支持严格 json_schema 结构化输出与原生 tool calling。
# json_schema（默认）：走 response_format={"type":"json_schema","strict":true}，schema 由接口下发；
# Provider 不支持时改成 json_object 降级（schema 拼进 prompt），其它取值直接报 RF-001。
RF_LLM_STRUCTURED_OUTPUT=json_schema
# 模型是否支持原生 tool calling。不支持（0/false/no）时，带 tools 的 chat() 直接报错不发请求。
RF_LLM_SUPPORTS_TOOLS=1

# 原样合并进每次请求 body 的额外 JSON 对象（Provider 专属参数，如思考模式开关）。
# 例如百炼 Qwen 关闭思考可能是 {"enable_thinking": false}（以 Provider 文档为准）。
# 非法 JSON 会导致启动报错（RF-001）。
RF_LLM_EXTRA_BODY={}

# --- 嵌入（T-030，仅离线重排评测真实层使用）-----------------------------------
# 缺省回落到上面的 RF_LLM_BASE_URL / RF_LLM_API_KEY；模型必须填 Provider 的
# 嵌入模型（如 text-embedding-3-small）。不要把真实 Key 写进本文件。
# RF_EMBED_BASE_URL=
# RF_EMBED_MODEL=
# RF_EMBED_API_KEY=
